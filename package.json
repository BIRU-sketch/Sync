{
  "name": "voice-companion",
  "version": "0.0.0",
  "private": true,
  "description": "Low-latency desktop voice companion for developers, built on Voxide.",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.json",
    "dev:electron": "tsc -p tsconfig.json -w",
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:app\"",
    "dev:app": "npm run build:electron && electron .",
    "build": "vite build",
    "start": "electron ."
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@voxide/react": "^0.8.0",
    "dotenv": "^18.0.0"
  }
}
